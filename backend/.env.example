APP_ENV=production
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=civicconnect_ai
JWT_SECRET=<random-secret-at-least-32-characters>
ADMIN_EMAIL=<project-admin-email>
ADMIN_PASSWORD=<unique-password-at-least-12-characters>
ADMIN_NAME=Project Administrator
# Comma-separated exact Vercel frontend origins allowed to call this API.
FRONTEND_ORIGINS=https://<your-vercel-domain>,https://<your-preview-domain>.vercel.app
# Production uploads use MongoDB GridFS so they survive Render restarts.
# Local development uses the repository's uploads/ folder.
# UPLOAD_DIR=/data/uploads
DEMO_MODE=true
# Keep these private in the API provider. The frontend prompts for the access key.
DEMO_ACCESS_KEY=<shared-class-demo-key-at-least-24-characters>
DEMO_PASSWORD=<shared-demo-account-password-at-least-12-characters>
