APP_ENV=production
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=civicconnect_ai
JWT_SECRET=<random-secret-at-least-32-characters>
ADMIN_EMAIL=<project-admin-email>
ADMIN_PASSWORD=<unique-password-at-least-12-characters>
ADMIN_NAME=Project Administrator
FRONTEND_ORIGINS=https://<your-vercel-domain>,https://<your-project>.vercel.app
UPLOAD_DIR=/data/uploads
DEMO_MODE=false
# Only needed if you intentionally enable public demo role switching.
DEMO_ACCESS_KEY=<shared-class-demo-key-at-least-24-characters>
DEMO_PASSWORD=<shared-demo-account-password-at-least-12-characters>
